<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Escalade EPS</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jsQR/1.4.0/jsQR.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap');

:root{
  --bg:#EDEAE2;
  --bg-alt:#E2DDCF;
  --card:#F7F5EF;
  --ink:#22262B;
  --ink-soft:#5B584F;
  --line:#D9D3C3;
  --rope:#C98A3E;
  --rope-dark:#A66E2C;
  --wall:#2F5D8A;
  --wall-dark:#234A6E;
  --red:#C4432B;
  --red-bg:#F3DBD3;
  --yellow:#C98F1F;
  --yellow-bg:#F4E6C4;
  --green:#3C8A5B;
  --green-bg:#DAEADF;
  --radius:16px;
  --shadow:0 2px 10px rgba(34,38,43,.08);
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  font-family:'Inter',system-ui,sans-serif;
  background:var(--bg);
  color:var(--ink);
  min-height:100vh;
  -webkit-tap-highlight-color:transparent;
  overscroll-behavior:none;
}
h1,h2,h3,.display{font-family:'Space Grotesk',sans-serif; letter-spacing:-.01em;}
#app{max-width:900px;margin:0 auto;padding:18px 16px 60px;min-height:100vh;}
button{font-family:inherit;cursor:pointer;}
.hidden{display:none!important;}

/* ---------- topbar ---------- */
.topbar{
  display:flex;align-items:center;justify-content:space-between;
  padding:10px 4px 18px;
}
.topbar .brand{display:flex;align-items:center;gap:10px;}
.topbar .brand svg{width:34px;height:34px;flex:none;}
.topbar .brand-text{display:flex;flex-direction:column;line-height:1.1;}
.topbar .brand-text .app-name{font-family:'Space Grotesk';font-weight:700;font-size:18px;}
.topbar .brand-text .app-sub{font-size:11px;color:var(--ink-soft);}
.topbar-actions{display:flex;gap:8px;}
.icon-btn{
  background:var(--card);border:1px solid var(--line);border-radius:12px;
  width:40px;height:40px;display:flex;align-items:center;justify-content:center;
  color:var(--ink);
}
.icon-btn svg{width:18px;height:18px;}

/* ---------- generic layout ---------- */
.screen-title{display:flex;align-items:center;gap:10px;margin:4px 0 18px;}
.screen-title h2{margin:0;font-size:20px;}
.back-btn{
  background:none;border:none;color:var(--ink);display:flex;align-items:center;
  padding:6px;border-radius:10px;
}
.back-btn:hover{background:var(--bg-alt);}
.back-btn svg{width:20px;height:20px;}

.card{
  background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
  padding:16px;box-shadow:var(--shadow);margin-bottom:12px;
}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
@media(max-width:520px){.grid-2{grid-template-columns:1fr;}}

.btn{
  border-radius:12px;border:none;padding:14px 18px;font-weight:600;font-size:15px;
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
}
.btn-primary{background:var(--rope);color:#fff;}
.btn-primary:active{background:var(--rope-dark);}
.btn-secondary{background:var(--wall);color:#fff;}
.btn-secondary:active{background:var(--wall-dark);}
.btn-outline{background:transparent;border:1.5px solid var(--line);color:var(--ink);}
.btn-outline:active{background:var(--bg-alt);}
.btn-danger{background:var(--red);color:#fff;}
.btn-ghost{background:none;border:none;color:var(--ink-soft);font-weight:500;}
.btn-block{width:100%;}
.btn-lg{padding:20px;font-size:17px;}
.btn:disabled{opacity:.4;}

input[type=text],input[type=password],input[type=number],select,textarea{
  width:100%;padding:12px 14px;border-radius:11px;border:1.5px solid var(--line);
  font-size:15px;font-family:inherit;background:#fff;color:var(--ink);
}
label.field-label{font-size:12px;font-weight:600;color:var(--ink-soft);text-transform:uppercase;letter-spacing:.04em;margin-bottom:5px;display:block;}
.field{margin-bottom:14px;}

/* ---------- home ---------- */
.home-hero{
  text-align:center;padding:18px 10px 26px;
}
.home-hero svg{width:80px;height:80px;}
.home-hero h1{font-size:26px;margin:10px 0 4px;}
.home-hero p{color:var(--ink-soft);margin:0;font-size:14px;}
.home-choices{display:flex;flex-direction:column;gap:14px;}
.mode-tile{
  display:flex;align-items:center;gap:16px;padding:20px;border-radius:var(--radius);
  border:1.5px solid var(--line);background:var(--card);box-shadow:var(--shadow);text-align:left;
}
.mode-tile .tile-icon{
  width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;flex:none;
}
.mode-tile .tile-icon svg{width:28px;height:28px;color:#fff;}
.mode-tile.tile-eleve .tile-icon{background:var(--rope);}
.mode-tile.tile-prof .tile-icon{background:var(--wall);}
.mode-tile.tile-histo .tile-icon{background:#8A7B5C;}
.mode-tile.tile-gestion .tile-icon{background:#6B6459;}
.mode-tile .tile-text strong{display:block;font-size:16px;margin-bottom:2px;}
.mode-tile .tile-text span{font-size:13px;color:var(--ink-soft);}

/* ---------- route-tag (signature element) ---------- */
.tag{
  display:inline-flex;align-items:center;justify-content:center;
  border-radius:10px;font-family:'Space Grotesk';font-weight:700;
  border:2px solid transparent;
}
.tag-num{width:44px;height:44px;font-size:17px;background:var(--card);border-color:var(--line);color:var(--ink);}
.tag-num.selected{background:var(--wall);border-color:var(--wall);color:#fff;}
.tag-grade{padding:10px 6px;font-size:14px;background:var(--card);border-color:var(--line);color:var(--ink);min-width:56px;}
.tag-grade.selected{background:var(--rope);border-color:var(--rope);color:#fff;}
.tag-mini{width:30px;height:30px;font-size:12px;border-radius:8px;}

.badge-state{width:14px;height:14px;border-radius:50%;display:inline-block;flex:none;}
.badge-state.st-rouge{background:var(--red);}
.badge-state.st-jaune{background:var(--yellow);}
.badge-state.st-vert{background:var(--green);}
.badge-state.st-suspendu{background:repeating-linear-gradient(45deg,#8a8a8a,#8a8a8a 3px,#c9c4b5 3px,#c9c4b5 6px);}

.badge-pill{
  display:inline-flex;align-items:center;gap:6px;padding:6px 12px 6px 8px;border-radius:999px;
  font-size:12px;font-weight:700;
}
.badge-pill.st-rouge{background:var(--red);color:#fff;}
.badge-pill.st-jaune{background:var(--yellow);color:#fff;}
.badge-pill.st-vert{background:var(--green);color:#fff;}
.badge-pill.st-suspendu{background:#6b675c;color:#fff;}
.badge-dot{
  width:30px;height:30px;border-radius:9px;display:inline-flex;align-items:center;justify-content:center;
  font-weight:800;font-size:12px;color:#fff;flex:none;box-shadow:0 1px 3px rgba(0,0,0,.18);
}
.badge-dot.st-rouge{background:var(--red);}
.badge-dot.st-jaune{background:var(--yellow);}
.badge-dot.st-vert{background:var(--green);}
.badge-dot.st-suspendu{background:#77746a;}

/* ---------- choice grid (wizard) ---------- */
.choice-grid{display:flex;flex-wrap:wrap;gap:10px;margin:14px 0;}
.wizard-progress{font-size:12px;color:var(--ink-soft);font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px;}
.wizard-question{font-size:19px;font-weight:700;margin:0 0 14px;font-family:'Space Grotesk';}
.recap-bar{
  display:flex;flex-wrap:wrap;gap:8px;padding:12px;background:var(--bg-alt);border-radius:14px;margin-bottom:18px;
}
.recap-chip{
  background:var(--card);border:1px solid var(--line);border-radius:10px;padding:6px 10px;font-size:13px;
  display:flex;align-items:center;gap:6px;font-weight:600;
}
.recap-chip .lbl{color:var(--ink-soft);font-weight:500;}

/* ---------- lists ---------- */
.list-row{
  display:flex;align-items:center;justify-content:space-between;gap:10px;
  padding:13px 14px;border-radius:12px;background:var(--card);border:1px solid var(--line);margin-bottom:8px;
}
.list-row .row-main{display:flex;align-items:center;gap:12px;min-width:0;}
.list-row .row-title{font-weight:600;font-size:15px;}
.list-row .row-sub{font-size:12px;color:var(--ink-soft);}
.row-badges{display:flex;gap:6px;}

table.recap-table{width:100%;border-collapse:collapse;font-size:13px;}
table.recap-table th{
  text-align:left;padding:8px 6px;border-bottom:2px solid var(--line);font-size:11px;
  text-transform:uppercase;color:var(--ink-soft);letter-spacing:.03em;
}
table.recap-table td{padding:9px 6px;border-bottom:1px solid var(--line);}
table.recap-table tr:active{background:var(--bg-alt);}

.competency-row{
  display:flex;align-items:center;justify-content:space-between;padding:11px 4px;border-bottom:1px solid var(--line);
  gap:10px;
}
.competency-row:last-child{border-bottom:none;}
.competency-row .comp-label{font-size:14px;flex:1;}
.tristate{display:flex;border-radius:10px;overflow:hidden;border:1.5px solid var(--line);flex:none;}
.tristate button{border:none;padding:8px 10px;font-size:12px;font-weight:700;background:#fff;color:var(--ink-soft);}
.tristate button.on-non{background:var(--red);color:#fff;}
.tristate button.on-encours{background:var(--yellow);color:#fff;}
.tristate button.on-oui{background:var(--green);color:#fff;}

.section-label{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-soft);margin:20px 0 8px;}
.section-label:first-child{margin-top:0;}

.modal-backdrop{
  position:fixed;inset:0;background:rgba(34,38,43,.55);display:flex;align-items:center;justify-content:center;
  padding:20px;z-index:100;
}
.modal{
  background:var(--card);border-radius:18px;padding:22px;max-width:400px;width:100%;box-shadow:0 10px 40px rgba(0,0,0,.25);
  max-height:85vh;overflow-y:auto;
}
.modal h3{margin-top:0;}
.toast{
  position:fixed;bottom:22px;left:50%;transform:translateX(-50%);
  background:var(--ink);color:#fff;padding:12px 20px;border-radius:12px;font-size:14px;font-weight:600;
  z-index:200;box-shadow:0 6px 20px rgba(0,0,0,.25);
}
.empty-state{text-align:center;padding:40px 20px;color:var(--ink-soft);}
.empty-state svg{width:50px;height:50px;opacity:.4;margin-bottom:10px;}
.stat-row{display:flex;gap:10px;margin-bottom:14px;}
.stat-box{flex:1;background:var(--bg-alt);border-radius:12px;padding:12px;text-align:center;}
.stat-box .num{font-family:'Space Grotesk';font-weight:700;font-size:22px;}
.stat-box .lbl{font-size:11px;color:var(--ink-soft);text-transform:uppercase;letter-spacing:.03em;}
.tabs{display:flex;gap:6px;margin-bottom:16px;background:var(--bg-alt);border-radius:12px;padding:4px;}
.tabs button{flex:1;border:none;background:none;padding:9px;border-radius:9px;font-weight:600;font-size:13px;color:var(--ink-soft);}
.tabs button.active{background:var(--card);color:var(--ink);box-shadow:var(--shadow);}
.warn-banner{
  background:var(--red-bg);color:var(--red);padding:10px 14px;border-radius:12px;font-size:13px;font-weight:600;
  margin-bottom:12px;display:flex;gap:8px;align-items:flex-start;
}
.session-banner{
  background:var(--wall);color:#fff;border-radius:14px;padding:12px 16px;display:flex;align-items:center;
  justify-content:space-between;margin-bottom:14px;
}
.session-banner .live-dot{width:9px;height:9px;background:#fff;border-radius:50%;display:inline-block;margin-right:7px;
  animation:pulse 1.4s infinite;}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.35;}}
.link-btn{background:none;border:none;color:var(--wall);font-weight:600;font-size:13px;text-decoration:underline;padding:4px;}
#qr-render{display:flex;justify-content:center;padding:14px;background:#fff;border-radius:12px;margin:12px 0;}
video#scan-video{width:100%;border-radius:12px;background:#000;}
</style>
</head>
<body>
<div id="app"></div>
<div id="modal-root"></div>
<div id="toast-root"></div>

<script>
/* =====================================================================
   ESCALADE EPS — application autonome (localStorage)
   ===================================================================== */

/* ---------- Référentiel de compétences (fixe) ---------- */
const COMMUNES = [
  {id:'c1', label:"Savoir mettre en baudrier seul (même emmêlé)"},
  {id:'c2', label:"Reconnaître les différentes voies et leurs cordes respectives"},
  {id:'c3', label:"Ne pas se mettre trop proche des camarades des autres groupes"},
];
const COMP_GRIMPEUR = [
  {id:'g1', label:"Nœud de 8"},
  {id:'g2', label:"Double nœud de 8"},
  {id:'g3', label:"Nœud d'arrêt"},
  {id:'g4', label:"Vérifier que les cordes ne sont pas vrillées"},
  {id:'g5', label:"Co-vérification avec les assureurs / contre-assureurs"},
  {id:'g6', label:"Attendre le feu vert de l'enseignant"},
  {id:'g7', label:"Communication normée avec l'assureur"},
  {id:'g8', label:"Pieds contre le mur au moment de la descente"},
  {id:'g9', label:"Réception : se remettre sur les pieds"},
];
const COMP_ASSUREUR = [
  {id:'a1', label:"Vérifier que les cordes ne sont pas vrillées"},
  {id:'a2', label:"S'encorder avec le descendeur"},
  {id:'a3', label:"Maîtriser l'assurage en 5 temps"},
  {id:'a4', label:"Co-vérification avec grimpeur / contre-assureur"},
  {id:'a5', label:"Attendre le feu vert de l'enseignant"},
  {id:'a6', label:"Communication normée"},
  {id:'a7', label:"Maîtrise de la descente en \u00ab piston \u00bb"},
  {id:'a8', label:"Descendre le grimpeur doucement"},
  {id:'a9', label:"Ramener au sol doucement, sans à-coup"},
];
const COMP_CONTRE = [
  {id:'ca1', label:"Vérifier que les cordes ne sont pas vrillées"},
  {id:'ca2', label:"Se positionner au bon endroit par rapport à l'assureur"},
  {id:'ca3', label:"Co-vérification avec grimpeur / assureur"},
  {id:'ca4', label:"Garder la corde en U sans jamais qu'elle touche le sol"},
  {id:'ca5', label:"Aider le grimpeur en lui donnant des conseils"},
];
const BREVETS = {
  grimpeur:{key:'grimpeur', label:'Permis de grimper', role:'grimpeur', specific:COMP_GRIMPEUR},
  assureur:{key:'assureur', label:"Permis d'assurer", role:'assureur', specific:COMP_ASSUREUR},
  contre:{key:'contre', label:'Permis de contre-assurer', role:'contre-assureur', specific:COMP_CONTRE},
};
function allCompsForBrevet(key){ return COMMUNES.concat(BREVETS[key].specific); }

const COMM_PHRASES = [
  ["Le grimpeur (avant de partir)", "« Prêt ? »"],
  ["L'assureur répond", "« Vas-y ! »"],
  ["Le grimpeur répond au moment de partir", "« Parti ! »"],
  ["Le grimpeur (pour que l'assureur reprenne la corde)", "« Récupère ! »"],
  ["Le grimpeur (pour que l'assureur donne du mou)", "« Du mou ! »"],
  ["Le grimpeur (pour que l'assureur tende la corde, vite)", "« Sec ! »"],
];

const GRADES = ["Toutes prises","3a","3b","3c","4a","4b","4c","5a","5b","5c","6a","6a+","6b","6b+","6c","6c+","7a"];
const HAUTEURS = ["1ère dégaine","2e dégaine","3e dégaine","4e dégaine","5e dégaine","6e dégaine","7e dégaine","8e dégaine","9e dégaine","10e dégaine","Sommet"];

/* ---------- Stockage ---------- */
const DB_KEY = 'escalade_db_v1';
function defaultDB(){
  return {
    password: null, // null = pas encore défini
    classes: [], // {id,name}
    students: [], // {id,prenom,nom,genre,classId}
    voies: Array.from({length:20},(_,i)=>({numero:i+1, cotation:''})),
    brevetData: {}, // studentId -> { commune:{cid:'oui'/'non'/'encours'}, grimpeur:{...specific}, assureur:{...}, contre:{...},
                     //   suspensions:{grimpeur:{active,sessionsRemaining}, assureur:{...}, contre:{...}} }
    classSettings: {}, // classId -> {targetGrimpeur, targetAssureur, targetContre}
    sessions: [], // {id,classId,date,startedAt,endedAt,entries:[],disqualifs:[]}
    currentSessionId: null,
  };
}
let DB = loadDB();
function loadDB(){
  try{
    const raw = localStorage.getItem(DB_KEY);
    if(!raw) return defaultDB();
    const parsed = JSON.parse(raw);
    const db = Object.assign(defaultDB(), parsed);
    migrateStudents(db);
    return db;
  }catch(e){ return defaultDB(); }
}
function migrateStudents(db){
  // ancien format : classes[].students = [{id,name}]
  if(!Array.isArray(db.students)) db.students = [];
  (db.classes||[]).forEach(c=>{
    if(Array.isArray(c.students)){
      c.students.forEach(old=>{
        db.students.push({id:old.id, prenom:old.name||'', nom:'', genre:'', classId:c.id});
      });
      delete c.students;
    }
  });
}
function saveDB(){ localStorage.setItem(DB_KEY, JSON.stringify(DB)); }

/* ---------- Élèves : helpers ---------- */
function studentsOfClass(classId){
  return DB.students.filter(s=>s.classId===classId).slice().sort(sortByFamilyName);
}
function sortByFamilyName(a,b){
  const ka = (a.nom||a.prenom||'').toLocaleLowerCase('fr');
  const kb = (b.nom||b.prenom||'').toLocaleLowerCase('fr');
  return ka.localeCompare(kb, 'fr');
}
function studentFullName(s){
  if(!s) return 'Élève supprimé';
  return s.nom ? (s.prenom+' '+s.nom.toUpperCase()) : s.prenom;
}
function studentFirstName(s){ return s? s.prenom : 'Élève supprimé'; }
function getStudent(id){ return DB.students.find(s=>s.id===id); }
function capName(s){
  return s.split('-').map(p=> p? p.charAt(0).toLocaleUpperCase('fr')+p.slice(1).toLocaleLowerCase('fr') : p).join('-');
}
function parseBulkNames(text){
  return text.split(/[\s,;\/]+/).map(t=>t.trim()).filter(Boolean).map(capName);
}

function uid(prefix){ return prefix + '_' + Math.random().toString(36).slice(2,9) + Date.now().toString(36).slice(-4); }

function getStudentBrevet(studentId){
  if(!DB.brevetData[studentId]){
    DB.brevetData[studentId] = {commune:{}, grimpeur:{}, assureur:{}, contre:{},
      suspensions:{grimpeur:null, assureur:null, contre:null}};
  }
  const bd = DB.brevetData[studentId];
  if(!bd.suspensions) bd.suspensions = {grimpeur:null, assureur:null, contre:null};
  return bd;
}
function getCompState(studentId, brevetKey, compId){
  const bd = getStudentBrevet(studentId);
  const isCommune = COMMUNES.some(c=>c.id===compId);
  const bucket = isCommune ? bd.commune : bd[brevetKey];
  return bucket[compId] || 'non';
}
function setCompState(studentId, brevetKey, compId, val){
  const bd = getStudentBrevet(studentId);
  const isCommune = COMMUNES.some(c=>c.id===compId);
  const bucket = isCommune ? bd.commune : bd[brevetKey];
  bucket[compId] = val;
  saveDB();
}
function brevetProgress(studentId, brevetKey){
  const comps = allCompsForBrevet(brevetKey);
  let oui=0;
  comps.forEach(c=>{ if(getCompState(studentId, brevetKey, c.id)==='oui') oui++; });
  return {oui, total:comps.length, pct: comps.length? oui/comps.length : 0};
}
function brevetStatus(studentId, brevetKey){
  const bd = getStudentBrevet(studentId);
  const susp = bd.suspensions[brevetKey];
  if(susp && susp.active) return 'suspendu';
  const p = brevetProgress(studentId, brevetKey);
  if(p.pct >= 0.999) return 'vert';
  if(p.pct >= 0.4) return 'jaune';
  return 'rouge';
}
function isBrevetValidated(studentId, brevetKey){
  return brevetStatus(studentId, brevetKey) === 'vert';
}

/* ---------- Séance courante ---------- */
function currentSession(){
  if(!DB.currentSessionId) return null;
  return DB.sessions.find(s=>s.id===DB.currentSessionId) || null;
}
function startSession(classId){
  const s = {id:uid('sess'), classId, date:new Date().toISOString(), startedAt:Date.now(), endedAt:null, entries:[], disqualifs:[]};
  DB.sessions.push(s);
  DB.currentSessionId = s.id;
  saveDB();
  return s;
}
function endSession(){
  const s = currentSession();
  if(!s) return;
  s.endedAt = Date.now();
  // décrément des suspensions pour les élèves ayant participé
  const participants = new Set();
  s.entries.forEach(e=>{ participants.add(e.studentId); (e.cordee||[]).forEach(m=>participants.add(m.studentId)); });
  participants.forEach(sid=>{
    const bd = getStudentBrevet(sid);
    ['grimpeur','assureur','contre'].forEach(k=>{
      const sus = bd.suspensions[k];
      if(sus && sus.active){
        sus.sessionsRemaining -= 1;
        if(sus.sessionsRemaining<=0){ sus.active=false; }
      }
    });
  });
  DB.currentSessionId = null;
  saveDB();
}

/* ---------- Disqualifications ---------- */
function logDisqualif(classId, voieNumero, membres){
  const s = currentSession();
  if(!s) return;
  s.disqualifs.push({id:uid('dq'), timestamp:Date.now(), voieNumero, membres});
  saveDB();
}
function countRecentDisqualifs(studentId){
  let n=0;
  DB.sessions.forEach(s=> s.disqualifs.forEach(d=>{
    if(d.membres.some(m=>m.studentId===studentId)) n++;
  }));
  return n;
}

/* ---------- Navigation / état UI ---------- */
let UI = {
  screen:'home',
  authed:false, // session prof/gestion déverrouillée (en mémoire, pas persistant)
  gestionClassId:null,
