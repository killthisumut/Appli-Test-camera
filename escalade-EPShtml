}
function setCompStateUI(studentId, brevetKey, compId, val){
  setCompState(studentId, brevetKey, compId, val);
  render();
}
function openSuspendModal(studentId, brevetKey){
  openModal(`
  <div class="modal">
    <h3>Suspendre ${esc(BREVETS[brevetKey].label.toLowerCase())}</h3>
    <p style="color:var(--ink-soft);font-size:14px;margin-top:-6px;">Le permis sera masqué le temps indiqué, puis reviendra automatiquement à son état antérieur.</p>
    <div class="field">
      <label class="field-label">Nombre de séances (participées)</label>
      <input type="number" id="susp-n" min="1" value="2">
    </div>
    <div style="display:flex;gap:10px;">
      <button class="btn btn-outline btn-block" onclick="closeModal()">Annuler</button>
      <button class="btn btn-danger btn-block" onclick="confirmSuspend('${studentId}','${brevetKey}')">Suspendre</button>
