/* ---------- PROF : transfert téléphone ---------- */
function profTransfertScreen(){
  return `
  ${screenTitle('Transfert téléphone ↔ tablette', 'prof-classes')}
  <div class="card">
    <h3 style="margin-top:0;">Depuis ce téléphone</h3>
    <p style="font-size:13px;color:var(--ink-soft);">Exporte les validations de permis saisies ici, pour les importer sur la tablette.</p>
    <button class="btn btn-primary btn-block" onclick="exportBrevetsTransfer()">Exporter les permis (fichier + QR code)</button>
    <div id="qr-render"></div>
  </div>
  <div class="card">
    <h3 style="margin-top:0;">Sur la tablette</h3>
    <p style="font-size:13px;color:var(--ink-soft);">Importe le fichier reçu, ou scanne le QR code affiché sur le téléphone.</p>
    <div style="display:flex;gap:10px;margin-bottom:10px;">
      <label class="btn btn-outline btn-block" style="text-align:center;">
        Importer un fichier
        <input type="file" accept="application/json" style="display:none;" onchange="importBrevetsTransfer(event)">
      </label>
      <button class="btn btn-outline btn-block" onclick="startQRScan(handleBrevetsQRData)">Scanner un QR code</button>
    </div>
    <video id="scan-video" class="hidden" playsinline></video>
    <canvas id="scan-canvas" class="hidden"></canvas>
  </div>`;
}
function exportBrevetsTransfer(){
  const data = {type:'escalade-brevets-transfer', exportedAt:new Date().toISOString(), brevetData:DB.brevetData};
  downloadJSON(data, 'permis-transfert.json');
  const json = JSON.stringify(data);
  const holder = document.getElementById('qr-render');
  holder.innerHTML='';
  if(json.length > 2200){
    holder.innerHTML = '<p style="font-size:12px;color:var(--ink-soft);text-align:center;">Trop de données pour un QR code — utilise le fichier exporté.</p>';
    return;
  }
  try{ new QRCode(holder, {text: json, width:220, height:220}); }
  catch(e){ holder.innerHTML = '<p style="font-size:12px;color:var(--ink-soft);">QR indisponible hors-ligne — utilise le fichier exporté.</p>'; }
}
function mergeBrevetData(incoming){
  Object.keys(incoming).forEach(studentId=>{
    if(!DB.brevetData[studentId]) DB.brevetData[studentId] = incoming[studentId];
    else {
      const local = DB.brevetData[studentId];
      const inc = incoming[studentId];
      ['commune','grimpeur','assureur','contre'].forEach(bucket=>{
        Object.assign(local[bucket], inc[bucket]||{});
      });
      if(inc.suspensions) Object.assign(local.suspensions, inc.suspensions);
    }
  });
  saveDB();
}
function importBrevetsTransfer(evt){
  const file = evt.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = e=>{
    try{
      const data = JSON.parse(e.target.result);
      mergeBrevetData(data.brevetData || {});
      showToast('Permis mis à jour depuis le fichier');
      render();
    }catch(err){ alertModal('Fichier invalide : '+err.message, 'Erreur'); }
  };
  reader.readAsText(file);
}
function handleBrevetsQRData(data){
  mergeBrevetData(data.brevetData || {});
  showToast('Permis mis à jour via QR code');
  render();
}
let scanStream = null;
function startQRScan(onData){
  const handler = onData || handleBrevetsQRData;
  const video = document.getElementById('scan-video');
  const canvas = document.getElementById('scan-canvas');
  video.classList.remove('hidden');
  navigator.mediaDevices.getUserMedia({video:{facingMode:'environment'}}).then(stream=>{
    scanStream = stream;
    video.srcObject = stream;
    video.play();
    requestAnimationFrame(function tick(){
      if(!scanStream) return;
      if(video.readyState === video.HAVE_ENOUGH_DATA){
        canvas.width = video.videoWidth; canvas.height = video.videoHeight;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(video, 0,0, canvas.width, canvas.height);
        const img = ctx.getImageData(0,0,canvas.width,canvas.height);
        const code = jsQR(img.data, img.width, img.height);
        if(code){
          try{
            const data = JSON.parse(code.data);
            stopQRScan();
            handler(data);
            return;
          }catch(e){/* pas un QR valide, on continue */}
        }
      }
      requestAnimationFrame(tick);
    });
  }).catch(err=>{
    alertModal("Impossible d'accéder à la caméra : "+err.message, 'Erreur');
    video.classList.add('hidden');
  });
}
function stopQRScan(){
  if(scanStream){ scanStream.getTracks().forEach(t=>t.stop()); scanStream=null; }
  const video = document.getElementById('scan-video');
  if(video){ video.classList.add('hidden'); }
}

