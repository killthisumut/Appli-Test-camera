}
function confirmSuspend(studentId, brevetKey){
  const n = parseInt(document.getElementById('susp-n').value,10) || 1;
  const bd = getStudentBrevet(studentId);
  bd.suspensions[brevetKey] = {active:true, sessionsRemaining:n};
  saveDB(); closeModal(); render();
  showToast('Permis suspendu pour '+n+' séance(s)');
}
function liftSuspension(studentId, brevetKey){
  const bd = getStudentBrevet(studentId);
  bd.suspensions[brevetKey] = null;
  saveDB(); render();
}

