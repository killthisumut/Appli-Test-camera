    <table class="recap-table" style="margin-top:10px;">
      ${COMM_PHRASES.map(p=>`<tr><td style="color:var(--ink-soft);">${esc(p[0])}</td><td style="font-weight:600;">${esc(p[1])}</td></tr>`).join('')}
    </table>
