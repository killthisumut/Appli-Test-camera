          <button class="${getCompState(studentId,brevetKey,comp.id)==='non'?'on-non':''}" onclick="setCompStateUI('${studentId}','${brevetKey}','${comp.id}','non')">NON</button>
          <button class="${getCompState(studentId,brevetKey,comp.id)==='encours'?'on-encours':''}" onclick="setCompStateUI('${studentId}','${brevetKey}','${comp.id}','encours')">EN COURS</button>
          <button class="${getCompState(studentId,brevetKey,comp.id)==='oui'?'on-oui':''}" onclick="setCompStateUI('${studentId}','${brevetKey}','${comp.id}','oui')">OUI</button>
