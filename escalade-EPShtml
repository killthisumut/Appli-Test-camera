function submitPassword(afterScreen, extraStr){
  const extra = typeof extraStr==='string' ? JSON.parse(extraStr.replace(/&quot;/g,'"')) : (extraStr||{});
  const pw = document.getElementById('pw-input').value;
  const errEl = document.getElementById('pw-error');
