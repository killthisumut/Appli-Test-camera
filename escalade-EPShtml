/* ---------- ELEVE : wizard ---------- */
function wizardSteps(){
  // étapes : cordée (2 rôles restants) puis voie, difficulté, hauteur
  const others = ['grimpeur','assureur','contre-assureur'].filter(r=>r!==UI.eleveRole);
  return [
    {type:'cordee', role:others[0]},
    {type:'cordee', role:others[1]},
    {type:'voie'},
    {type:'grade'},
    {type:'hauteur'},
    {type:'recap'},
  ];
}
function eleveWizardScreen(){
  const steps = wizardSteps();
  const step = steps[UI.eleveStep];
  const c = DB.classes.find(x=>x.id===UI.eleveClassId);
  const meStudent = getStudent(UI.eleveStudentId);

  let body = '';
  if(step.type==='cordee'){
    const excludeIds = [UI.eleveStudentId, ...Object.values(UI.eleveWizard.cordee).map(m=>m.studentId)];
    const candidates = studentsOfClass(UI.eleveClassId).filter(s=>!excludeIds.includes(s.id));
    body = `
    <div class="wizard-progress">Étape ${UI.eleveStep+1} / ${steps.length}</div>
    <div class="wizard-question">Qui était ${roleLabel(step.role)} ?</div>
    <div class="choice-grid">
      ${candidates.map(s=>`
        <button class="tag tag-grade" onclick="setCordee('${step.role}','${s.id}')">${esc(studentFirstName(s))}</button>`).join('')}
    </div>`;
  } else if(step.type==='voie'){
    body = `
    <div class="wizard-progress">Étape ${UI.eleveStep+1} / ${steps.length}</div>
    <div class="wizard-question">Numéro de la voie ?</div>
    <div class="choice-grid">
      ${DB.voies.map(v=>`<button class="tag tag-num ${UI.eleveWizard.voie===v.numero?'selected':''}" onclick="setWizardVal('voie',${v.numero})">${v.numero}</button>`).join('')}
    </div>`;
  } else if(step.type==='grade'){
    body = `
    <div class="wizard-progress">Étape ${UI.eleveStep+1} / ${steps.length}</div>
    <div class="wizard-question">Quelle difficulté ?</div>
    <div class="choice-grid">
      ${GRADES.map(g=>`<button class="tag tag-grade ${UI.eleveWizard.grade===g?'selected':''}" onclick="setWizardVal('grade','${g}')">${g}</button>`).join('')}
    </div>`;
  } else if(step.type==='hauteur'){
    body = `
    <div class="wizard-progress">Étape ${UI.eleveStep+1} / ${steps.length}</div>
    <div class="wizard-question">Jusqu'où es-tu allé ?</div>
    <div class="choice-grid">
      ${HAUTEURS.map(h=>`<button class="tag tag-grade ${UI.eleveWizard.hauteur===h?'selected':''}" onclick="setWizardVal('hauteur','${h}')">${h}</button>`).join('')}
    </div>`;
  } else if(step.type==='recap'){
    body = `
    <div class="wizard-question">Vérifie et valide</div>
    <div class="card">
      <table class="recap-table">
        <tr><td>Grimpeur</td><td><strong>${esc(roleName('grimpeur', meStudent))}</strong></td></tr>
        <tr><td>Assureur</td><td><strong>${esc(roleName('assureur', meStudent))}</strong></td></tr>
        <tr><td>Contre-assureur</td><td><strong>${esc(roleName('contre-assureur', meStudent))}</strong></td></tr>
        <tr><td>Voie</td><td><strong>N°${UI.eleveWizard.voie}</strong></td></tr>
        <tr><td>Difficulté</td><td><strong>${esc(UI.eleveWizard.grade)}</strong></td></tr>
        <tr><td>Hauteur atteinte</td><td><strong>${esc(UI.eleveWizard.hauteur)}</strong></td></tr>
      </table>
    </div>
    <button class="btn btn-primary btn-block btn-lg" onclick="validateEntry()">✓ Valider la saisie</button>
    `;
  }

  return `
  ${screenTitle('Nouvelle saisie', 'eleve-role')}
  ${recapBar(steps)}
  ${body}
  <div style="margin-top:16px;">
    ${UI.eleveStep>0? `<button class="btn btn-ghost" onclick="wizardBack()">← Étape précédente</button>` : ''}
  </div>
  `;
}
function roleLabel(r){ return r==='grimpeur'?'le grimpeur':r==='assureur'?"l'assureur":'le contre-assureur'; }
function roleName(role, meStudent){
  if(UI.eleveRole===role) return studentFirstName(meStudent) + ' (toi)';
  const entry = Object.values(UI.eleveWizard.cordee).find(m=>m.role===role);
  return entry? studentFirstName(getStudent(entry.studentId)) : '—';
}
function recapBar(steps){
  const w = UI.eleveWizard;
  const chips = [];
  Object.entries(w.cordee).forEach(([role,m])=>{
    chips.push({label:roleLabelShort(role), value: studentFirstName(getStudent(m.studentId)), stepIdx: steps.findIndex(s=>s.type==='cordee'&&s.role===role)});
  });
  if(w.voie) chips.push({label:'Voie', value:'N°'+w.voie, stepIdx: steps.findIndex(s=>s.type==='voie')});
  if(w.grade) chips.push({label:'Difficulté', value:w.grade, stepIdx: steps.findIndex(s=>s.type==='grade')});
  if(w.hauteur) chips.push({label:'Hauteur', value:w.hauteur, stepIdx: steps.findIndex(s=>s.type==='hauteur')});
  if(chips.length===0) return '';
  return `<div class="recap-bar">${chips.map(ch=>`<button class="recap-chip" onclick="jumpToStep(${ch.stepIdx})"><span class="lbl">${ch.label}:</span> ${esc(ch.value)}</button>`).join('')}</div>`;
}
function roleLabelShort(r){ return r==='grimpeur'?'Grimpeur':r==='assureur'?'Assureur':'Contre-ass.'; }
function jumpToStep(idx){ if(idx>=0){ UI.eleveStep = idx; render(); } }
function setCordee(role, studentId){
  UI.eleveWizard.cordee[role] = {role, studentId};
  UI.eleveStep++;
  render();
}
function setWizardVal(key, val){
  UI.eleveWizard[key] = val;
  UI.eleveStep++;
  render();
}
function wizardBack(){ UI.eleveStep = Math.max(0, UI.eleveStep-1); render(); }

function validateEntry(){
  const s = currentSession();
  if(!s){ alertModal("Aucune séance ouverte. Demande au professeur de démarrer la séance.", 'Séance fermée'); return; }
  const meStudent = getStudent(UI.eleveStudentId);
  const cordeeArr = [{role:UI.eleveRole, studentId:meStudent.id}]
    .concat(Object.values(UI.eleveWizard.cordee).map(m=>({role:m.role, studentId:m.studentId})));
  const entry = {
    id:uid('entry'), timestamp:Date.now(), studentId:meStudent.id, role:UI.eleveRole,
    voieNumero:UI.eleveWizard.voie, grade:UI.eleveWizard.grade, hauteur:UI.eleveWizard.hauteur,
    cordee:cordeeArr,
  };
  s.entries.push(entry);
  saveDB();
  showToast('Voie enregistrée — bravo !');
  nav('eleve-eleves', {eleveClassId:s.classId});
}

