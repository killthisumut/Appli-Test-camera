/* ---------- Export / import inter-applications (format commun) ---------- */
function buildClassesExportPayload(){
  return {
    type:'eps-classes-export', version:1, source:'escalade',
    exportedAt:new Date().toISOString(),
    classes: DB.classes.map(c=>({
      name:c.name,
      students: studentsOfClass(c.id).map(s=>({prenom:s.prenom, nom:s.nom||'', genre:s.genre||''}))
    }))
  };
}
