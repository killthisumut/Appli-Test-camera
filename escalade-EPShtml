/* ---------- Modal helpers ---------- */
function openModal(html){ document.getElementById('modal-root').innerHTML = '<div class="modal-backdrop" onclick="if(event.target===this)closeModal()">'+html+'</div>'; }
function closeModal(){ document.getElementById('modal-root').innerHTML=''; }

let _pendingConfirmAction = null;
function confirmModal(message, action, opts){
  opts = opts || {};
  _pendingConfirmAction = action;
  openModal(`
  <div class="modal">
    <h3>${esc(opts.title || 'Confirmation')}</h3>
    <p style="color:var(--ink-soft);font-size:14px;margin-top:-6px;">${esc(message)}</p>
    <div style="display:flex;gap:10px;">
      <button class="btn btn-outline btn-block" onclick="cancelPendingConfirm()">Annuler</button>
      <button class="btn ${opts.danger===false?'btn-primary':'btn-danger'} btn-block" onclick="runPendingConfirm()">${esc(opts.confirmLabel || 'Confirmer')}</button>
    </div>
  </div>`);
}
function runPendingConfirm(){
  const action = _pendingConfirmAction;
  _pendingConfirmAction = null;
  closeModal();
  if(action) action();
}
function cancelPendingConfirm(){
  _pendingConfirmAction = null;
  closeModal();
}
function alertModal(message, title){
  openModal(`
  <div class="modal">
    <h3>${esc(title||'Information')}</h3>
    <p style="color:var(--ink-soft);font-size:14px;margin-top:-6px;">${esc(message)}</p>
    <button class="btn btn-primary btn-block" onclick="closeModal()">OK</button>
  </div>`);
}
function promptModal(title, currentValue, onSave, opts){
  opts = opts || {};
  openModal(`
  <div class="modal">
    <h3>${esc(title)}</h3>
    <div class="field"><input type="text" id="prompt-input" value="${esc(currentValue||'')}"></div>
    <div style="display:flex;gap:10px;">
      <button class="btn btn-outline btn-block" onclick="closeModal()">Annuler</button>
      <button class="btn btn-primary btn-block" onclick="submitPromptModal()">${esc(opts.confirmLabel||'Enregistrer')}</button>
    </div>
  </div>`);
  _pendingPromptSave = onSave;
  setTimeout(()=>{ const el=document.getElementById('prompt-input'); if(el){ el.focus(); el.select(); } }, 30);
}
let _pendingPromptSave = null;
function submitPromptModal(){
  const val = document.getElementById('prompt-input').value.trim();
  const save = _pendingPromptSave;
  _pendingPromptSave = null;
  closeModal();
  if(val && save) save(val);
}

