function histoSessionScreen(){
  const s = DB.sessions.find(x=>x.id===UI.histoSessionId);
  if(!s) return emptyState('Séance introuvable', historyIcon());
  const cls = DB.classes.find(c=>c.id===s.classId);
  const dt = new Date(s.date);
  // agrégats par élève
  const stats = {};
  (cls? studentsOfClass(cls.id) : []).forEach(st=> stats[st.id] = {studentId:st.id, grimpeur:0, assureur:0, contre:0});
  s.entries.forEach(e=>{
    e.cordee.forEach(m=>{
      if(!stats[m.studentId]) stats[m.studentId] = {studentId:m.studentId, grimpeur:0, assureur:0, contre:0};
      if(m.role==='grimpeur') stats[m.studentId].grimpeur++;
      else if(m.role==='assureur') stats[m.studentId].assureur++;
      else stats[m.studentId].contre++;
    });
  });
  return `
  ${screenTitle(cls?cls.name:'Séance', 'histo')}
  <p style="color:var(--ink-soft);font-size:13px;margin-top:-10px;">${dt.toLocaleDateString('fr-FR',{weekday:'long',day:'numeric',month:'long',year:'numeric'})}</p>
  <div class="stat-row">
    <div class="stat-box"><div class="num">${s.entries.length}</div><div class="lbl">Voies saisies</div></div>
    <div class="stat-box"><div class="num">${s.disqualifs.length}</div><div class="lbl">Disqualifs.</div></div>
    <div class="stat-box"><div class="num">${s.endedAt? 'Clôturée':'En cours'}</div><div class="lbl">Statut</div></div>
  </div>
  <div class="section-label">Récapitulatif par élève</div>
  <div class="card" style="overflow-x:auto;">
    <table class="recap-table">
      <tr><th>Élève</th><th>Grimpées</th><th>Assurées</th><th>Contre-ass.</th></tr>
      ${Object.values(stats).map(st=>`<tr><td>${esc(studentFullName(getStudent(st.studentId)))}</td><td>${st.grimpeur}</td><td>${st.assureur}</td><td>${st.contre}</td></tr>`).join('')}
    </table>
  </div>
  <div class="section-label">Détail des voies</div>
  ${s.entries.length===0? emptyState('Aucune voie saisie', routeIcon()) : s.entries.map(e=>`
    <div class="list-row" style="cursor:pointer;" onclick="openEntryDetail('${s.id}','${e.id}')">
      <div class="row-main">
        <span class="tag tag-mini">${e.voieNumero}</span>
        <div>
          <div class="row-title">${esc(studentFullName(getStudent(e.studentId)))} · ${esc(e.grade)}</div>
          <div class="row-sub">${roleLabelShort(e.role)} — ${esc(e.hauteur)}</div>
        </div>
      </div>
      <span>→</span>
    </div>`).join('')}
  `;
}
function openEntryDetail(sessionId, entryId){
  const s = DB.sessions.find(x=>x.id===sessionId);
  const e = s.entries.find(x=>x.id===entryId);
  openModal(`
  <div class="modal">
    <h3>Voie N°${e.voieNumero} — ${esc(e.grade)}</h3>
    <table class="recap-table">
      ${e.cordee.map(m=>`<tr><td>${roleLabelShort(m.role)}</td><td><strong>${esc(studentFullName(getStudent(m.studentId)))}</strong></td></tr>`).join('')}
      <tr><td>Hauteur atteinte</td><td><strong>${esc(e.hauteur)}</strong></td></tr>
      <tr><td>Heure</td><td>${new Date(e.timestamp).toLocaleTimeString('fr-FR')}</td></tr>
    </table>
    <button class="btn btn-outline btn-block" style="margin-top:14px;" onclick="closeModal()">Fermer</button>
  </div>`);
}

/* ---------- helpers UI ---------- */
function screenTitle(title, backScreen){
  return `<div class="screen-title">
    <button class="back-btn" onclick="nav('${backScreen}')">${backIcon()}</button>
    <h2>${esc(title)}</h2>
  </div>`;
}
function emptyState(text, iconSvg){
  return `<div class="empty-state">${iconSvg}<p>${esc(text)}</p></div>`;
}
function downloadJSON(obj, filename){
  const blob = new Blob([JSON.stringify(obj,null,2)], {type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

