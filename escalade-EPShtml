function exportClassesQR(){
  const data = buildClassesExportPayload();
  const json = JSON.stringify(data);
  const holder = document.getElementById('qr-render-classes');
  if(!holder) return;
  holder.innerHTML='';
  if(json.length > 2200){
    holder.innerHTML = '<p style="font-size:12px;color:var(--ink-soft);text-align:center;">Trop de données pour un QR code — utilise le fichier exporté.</p>';
    return;
  }
  try{ new QRCode(holder, {text: json, width:220, height:220}); }
  catch(e){ holder.innerHTML = '<p style="font-size:12px;color:var(--ink-soft);">QR indisponible hors-ligne — utilise le fichier exporté.</p>'; }
}
function applyClassesImport(data){
  const incomingClasses = data.classes || (Array.isArray(data)? data : []);
  if(!Array.isArray(incomingClasses)) throw new Error('format invalide');
  const flatStudents = data.students; // ancien format escalade : students séparés avec classId
  let count = 0;
  incomingClasses.forEach(c=>{
    let target = DB.classes.find(x=>x.name.toLowerCase()===String(c.name||'').toLowerCase());
    if(!target){ target = {id:uid('cls'), name:c.name}; DB.classes.push(target); }
    let incomingStudents = [];
    if(Array.isArray(c.students)){
      // format commun (ou ancien format imbriqué) : students dans la classe
      incomingStudents = c.students.map(st=>({prenom:st.prenom||st.name||'', nom:st.nom||'', genre:st.genre||''}));
    } else if(Array.isArray(flatStudents)){
      // ancien format escalade : students séparés, rattachés par classId
      incomingStudents = flatStudents.filter(st=>st.classId===c.id).map(st=>({prenom:st.prenom||st.name||'', nom:st.nom||'', genre:st.genre||''}));
    }
    incomingStudents.forEach(st=>{
      if(!st.prenom) return;
      const exists = DB.students.find(x=>x.classId===target.id && x.prenom.toLowerCase()===st.prenom.toLowerCase() && (x.nom||'').toLowerCase()===(st.nom||'').toLowerCase());
      if(!exists){ DB.students.push({id:uid('stu'), prenom:st.prenom, nom:st.nom, genre:st.genre, classId:target.id}); count++; }
    });
  });
  saveDB(); render();
  return count;
}
function importClasses(evt){
  const file = evt.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = e=>{
    try{
      const count = applyClassesImport(JSON.parse(e.target.result));
      showToast(count>0 ? count+' élève(s) importé(s)' : 'Classes importées (aucun nouvel élève)');
    }catch(err){ alertModal("Fichier invalide : "+err.message, 'Erreur'); }
  };
  reader.readAsText(file);
}
function handleClassesQRData(data){
  try{
    const count = applyClassesImport(data);
    showToast(count>0 ? count+' élève(s) importé(s) via QR code' : 'Classes importées via QR code');
  }catch(err){ alertModal('QR code invalide : '+err.message, 'Erreur'); }
}

